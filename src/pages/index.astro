---
import Base from '../layouts/Base.astro';
import HeroBoard from '../components/HeroBoard.astro';
import SiteNav from '../components/SiteNav.astro';
import ArticleList from '../components/ArticleList.astro';
import DemoStage from '../components/DemoStage.astro';
import { getPosts, BASE } from '../lib/posts';
const posts = await getPosts();
const first = posts[0];
---
<Base title="OctobLab" canonical={new URL(BASE, Astro.site).toString()}>
  <div class="home">
    <div class="home-wrap">
      <SiteNav />

      <section class="hero">
        <div>
          <div class="eyebrow">Robot control · physical AI · working notes</div>
          <h1>Read robotics like a whiteboard, not a scroll.</h1>
          <p class="lede">Every article here is a map of cards. Expand a card where it sits, open it in the reader beside the map, highlight what matters, and pin your own notes next to the ideas they came from. The simulations live inside the cards, so the equations move.</p>
          <div class="cta">
            {first && <a class="btn primary" href={`${BASE}posts/${first.id}/`}>Open the first article</a>}
            <a class="btn" href="#how">How it reads</a>
          </div>
        </div>
        {first && <HeroBoard href={`${BASE}posts/${first.id}/`} />}
      </section>

      <section class="section" id="articles">
        <div class="eyebrow">Articles</div>
        <h2>Start with one deep topic</h2>
        <p class="sub">Niche first, broad later. Each article is written in Markdown and split into cards by its headings, so it also exists as a plain page for search engines and feed readers.</p>
        <ArticleList posts={posts} />
        <p class="sub"><a href={`${BASE}articles/`}>All articles and tags →</a></p>
        <div class="article-list">
          <div class="post planned">
            <div class="meta"><span>Planned</span><span>Identification</span></div>
            <h3>Friction identification you can run in an afternoon</h3>
            <p>Stribeck fits, what the encoder resolution does to them, and how to feed the result into the observer.</p>
          </div>
          <div class="post planned">
            <div class="meta"><span>Planned</span><span>Learning</span></div>
            <h3>Sim-to-real for joint-level policies</h3>
            <p>Which physical effects break a learned controller first, and how the disturbance observer buys margin.</p>
          </div>
        </div>
      </section>

      <section class="section" id="how">
        <div class="eyebrow">How it reads</div>
        <h2>Three panes, one article</h2>
        <p class="sub">The structure of the article is the structure of the board. The author decides how deep the cards go; you decide how they are arranged.</p>
        <div class="how" role="tablist" aria-label="The three panes">
          <div class="step active" role="tab" tabindex="0" aria-selected="true" data-clip="contents"><span class="k">Contents</span><h3>The map on the left</h3><p>A table of contents built from the headings. Click any entry and the board flies to that card and opens it in the reader.</p></div>
          <div class="step" role="tab" tabindex="0" aria-selected="false" data-clip="board"><span class="k">Board</span><h3>Cards you can expand and move</h3><p>Cards start collapsed. Expand one in place and its neighbours make room. Drag cards, hide or draw connections. A reset puts the author's structure back. Simulations run only while their card is on screen.</p></div>
          <div class="step" role="tab" tabindex="0" aria-selected="false" data-clip="reader"><span class="k">Reader</span><h3>Highlights that become cards</h3><p>Select text in the reader to highlight it and add a note. Drag a highlight onto the board and it becomes a card, linked to where it came from. Everything stays in your browser.</p></div>
        </div>
        <DemoStage clips={[
          { name: 'contents', label: 'Contents · the map on the left', alt: 'Clicking entries in the contents list; the board pans to each card and the reader shows it' },
          { name: 'board', label: 'Board · cards you can expand and move', alt: 'Expanding a card so its neighbours move aside, dragging a card, and drawing a connection between two cards' },
          { name: 'reader', label: 'Reader · highlights that become cards', alt: 'Selecting text in the reader, highlighting it, and dragging the highlight onto the board where it becomes a note card' },
        ]} />
      </section>

      <section class="section" id="entries">
        <div class="eyebrow">Entry points</div>
        <h2>Where to go</h2>
        <div class="entries">
          <a class="entry" href={`${BASE}articles/`}><b>Articles</b><span>Long-form topics, one board each.</span></a>
          {first && <a class="entry" href={`${BASE}posts/${first.id}/#notes`}><b>My notes</b><span>Your highlights and board notes, kept on this device.</span></a>}
          <a class="entry" href={`${BASE}rss.xml`}><b>Feed</b><span>RSS of new articles.</span></a>
          <a class="entry" href="#about"><b>About</b><span>Who writes this and why.</span></a>
        </div>
      </section>

      <section class="section about" id="about">
        <div class="eyebrow">About</div>
        <h2>Notes from building robots</h2>
        <p>These are working notes from robot development: control, estimation, and what survives contact with real hardware. The site is a static build on GitHub Pages. Your highlights, notes and board layouts are stored in your own browser, and you can export them as a file. A sync plan for them may come later.</p>
        <p><a href="https://github.com/haymanmk/OctobLab">Source on GitHub</a></p>
      </section>

      <script>
        /* The stage plays the three clips in turn and loops. Columns are tabs; off screen it pauses; reduced motion gets stills with controls. */
        const videos = [...document.querySelectorAll<HTMLVideoElement>('.stage-video')];
        const steps = [...document.querySelectorAll<HTMLElement>('.how .step')];
        const bar = document.querySelector<HTMLElement>('.stage-bar span');
        const now = document.querySelector<HTMLElement>('.stage-now');
        const stage = document.getElementById('stage');
        if (videos.length && stage) {
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          const webm = !!videos[0].canPlayType('video/webm');
          const slots: HTMLElement[] = videos.map(v => {
            if (webm) return v;
            const img = document.createElement('img'); img.className = 'stage-video'; img.src = v.dataset.gif!; img.alt = v.getAttribute('aria-label') || ''; img.width = v.width; img.height = v.height; img.hidden = v.hidden;
            Object.assign(img.dataset, { seconds: v.dataset.seconds, label: v.dataset.label }); v.replaceWith(img); return img;
          });
          let i = 0, timer = 0, raf = 0, startedAt = 0, visible = true;
          const seconds = (el: HTMLElement) => +(el.dataset.seconds || 8);
          const stop = () => { clearTimeout(timer); cancelAnimationFrame(raf); const el = slots[i]; if (el instanceof HTMLVideoElement) el.pause(); };
          const tick = () => { const el = slots[i]; const f = el instanceof HTMLVideoElement && el.duration ? el.currentTime / el.duration : (performance.now() - startedAt) / 1000 / seconds(el); if (bar) bar.style.width = Math.min(100, f * 100) + '%'; raf = requestAnimationFrame(tick); };
          const play = () => {
            if (reduce || !visible) return;
            const el = slots[i]; startedAt = performance.now();
            if (el instanceof HTMLVideoElement) { el.currentTime = 0; el.play().catch(() => {}); }
            else { el.setAttribute('src', el.dataset.gif || (el as HTMLImageElement).src); timer = window.setTimeout(() => show(i + 1), seconds(el) * 1000); }
            raf = requestAnimationFrame(tick);
          };
          const show = (n: number) => {
            stop(); i = (n + slots.length) % slots.length;
            slots.forEach((el, k) => { el.hidden = k !== i; });
            steps.forEach((s, k) => { s.classList.toggle('active', k === i); s.setAttribute('aria-selected', String(k === i)); });
            if (now) now.textContent = slots[i].dataset.label || '';
            if (bar) bar.style.width = '0%';
            play();
          };
          videos.forEach(v => { v.addEventListener('ended', () => show(i + 1)); if (reduce) v.controls = true; });
          steps.forEach((s, k) => { s.addEventListener('click', () => show(k)); s.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); show(k); } }); });
          new IntersectionObserver(es => { visible = es.some(e => e.isIntersecting); if (visible) play(); else stop(); }, { threshold: 0.2 }).observe(stage);
          document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else play(); });
          show(0);
        }
      </script>
      <footer>
        <span>OctobLab · built from Markdown</span>
        <span>Highlights and layouts stay on your device.</span>
      </footer>
    </div>
  </div>
</Base>
