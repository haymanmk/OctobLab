---
/* A miniature of the real board, drawn as static SVG so the home page needs no script to show it. */
interface N { x: number; y: number; w: number; h: number; lines: string[]; lvl: string; cls?: string; sel?: boolean }
const nodes: N[] = [
  { x: 22, y: 150, w: 160, h: 92, lines: ['Nonlinear Disturbance', 'Observer for Robot', 'Control'], lvl: 'H1' },
  { x: 236, y: 22, w: 150, h: 56, lines: ['Why a disturbance', 'observer at all?'], lvl: 'H2' },
  { x: 236, y: 98, w: 150, h: 56, lines: ['The linear DOB', 'in one picture'], lvl: 'H2' },
  { x: 236, y: 174, w: 150, h: 56, lines: ['The nonlinear DOB'], lvl: 'H2', sel: true },
  { x: 236, y: 250, w: 150, h: 56, lines: ['Choosing the', 'observer gain'], lvl: 'H2' },
  { x: 236, y: 326, w: 150, h: 56, lines: ['Interactive simulation'], lvl: 'H2' },
  { x: 418, y: 236, w: 92, h: 40, lines: ['Bandwidth vs', 'noise'], lvl: 'H3' },
  { x: 418, y: 284, w: 92, h: 40, lines: ['Slowly varying'], lvl: 'H3' },
  { x: 418, y: 120, w: 96, h: 72, lines: ['“every term with q̈', 'cancels”', 'my note: check sign'], lvl: 'NOTE', cls: 'note' },
];
const edge = (a: number, b: number, cls: string) => { const A = nodes[a], B = nodes[b]; const x1 = A.x + A.w, y1 = A.y + Math.min(A.h / 2, 30), x2 = B.x, y2 = B.y + Math.min(B.h / 2, 30); const dx = Math.max(30, (x2 - x1) / 2); return { cls, d: `M${x1} ${y1} C${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}` }; };
const edges = [edge(0, 1, 'e'), edge(0, 2, 'e'), edge(0, 3, 'e'), edge(0, 4, 'e'), edge(0, 5, 'e'), edge(4, 6, 'e'), edge(4, 7, 'e'), edge(3, 8, 'n')];
const { href } = Astro.props;
---
<a class="hero-board" href={href} aria-label="Open the article board">
  <svg viewBox="0 0 530 400" role="img" aria-label="A board of article cards connected by arrows">
    <style>
      .e{fill:none;stroke:var(--edge);stroke-width:1.4}.n{fill:none;stroke:var(--edge-note);stroke-width:1.4;stroke-dasharray:2 4}
      .c{fill:var(--surface);stroke:var(--line)}.c.sel{stroke:var(--accent);stroke-width:1.6}.c.note{fill:var(--note);stroke:var(--note-line)}
      .t{font:500 10.5px var(--sans);fill:var(--fg)}.t.h1{font:600 11px var(--serif)}.t.nt{font:italic 9.5px var(--serif)}.l{font:9px var(--mono);fill:var(--muted);letter-spacing:.05em}
    </style>
    {edges.map(e => <path class={e.cls} d={e.d} />)}
    {nodes.map(n => (
      <g>
        <rect class={`c ${n.cls ?? ''} ${n.sel ? 'sel' : ''}`} x={n.x} y={n.y} width={n.w} height={n.h} rx="6" />
        <text class="l" x={n.x + 8} y={n.y + 13}>{n.lvl}</text>
        {n.lines.map((l, k) => <text class={`t ${n.lvl === 'H1' ? 'h1' : ''} ${n.cls === 'note' ? 'nt' : ''}`} x={n.x + 8} y={n.y + 28 + k * 14}>{l}</text>)}
      </g>
    ))}
  </svg>
  <span class="open">open the board →</span>
</a>
