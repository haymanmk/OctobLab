---
import { articleOf, BASE, type Post } from '../lib/posts';
interface Props { posts: Post[] }
const { posts } = Astro.props;
const counts = await Promise.all(posts.map(async p => (await articleOf(p)).cards.length));
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<div class="article-list">
  {posts.map((p, i) => (
    <article class="post">
      <div class="meta"><span>{fmt(p.data.date)}</span><span>{counts[i]} cards</span>{p.data.tags.map(t => <a href={`${BASE}articles/tag/${t}/`}>{t}</a>)}</div>
      <h3><a href={`${BASE}posts/${p.id}/`}>{p.data.title}</a></h3>
      <p>{p.data.description}</p>
    </article>
  ))}
</div>
