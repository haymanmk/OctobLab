---
/* A short looping clip of one interaction: WebM where it plays, the GIF where it does not, a still for reduced motion. */
import { BASE } from '../lib/posts';
interface Props { name: string; alt: string }
const { name, alt } = Astro.props;
const src = `${BASE}media/${name}`;
---
<figure class="demo">
  <video class="demo-video" autoplay muted loop playsinline preload="metadata" poster={`${src}.png`} aria-label={alt} data-gif={`${src}.gif`} width="880" height="512">
    <source src={`${src}.webm`} type="video/webm" />
    <img src={`${src}.gif`} alt={alt} loading="lazy" width="880" height="512" />
  </video>
</figure>
